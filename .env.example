# ==============================================================================
# CaloLens Environment Variables
# ==============================================================================

# ── AI Vision Model ──────────────────────────────────────────────────────────
# Gemini API Key for Server-Side AI Nutrition Estimation
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Nutrition Data Source ────────────────────────────────────────────────────
# USDA FoodData Central API Key (optional, enhances accuracy)
# Cross-references AI estimates with USDA nutritional reference data (per 100g).
# Obtain your key from: https://fdc.nal.usda.gov/api-key-signup.html
# Source status: Approved (see SOURCES.md)
USDA_API_KEY=your_usda_api_key_here

# ── App Configuration ───────────────────────────────────────────────────────
# Base App URL (used in production / preview environments)
NEXT_PUBLIC_APP_URL=http://localhost:3000
